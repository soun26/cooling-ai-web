{
  "name": "cooling-ai-user",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "MASTER", "class_name": "MasterLink" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MasterLink"] }]
}
